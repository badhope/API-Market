{
  "name": "frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:data": "tsx scripts/build-data.ts",
    "import:public-apis": "tsx scripts/import/run.ts",
    "import:public-apis:dry": "tsx scripts/import/run.ts --dry-run",
    "import:all": "tsx scripts/import/run-all.ts",
    "import:all:dry": "tsx scripts/import/run-all.ts --dry-run",
    "prebuild": "npm run build:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@orama/orama": "^3.1.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "smol-toml": "^1.3.1",
    "tailwindcss": "^4.3.0",
    "tinyglobby": "^0.2.13",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
